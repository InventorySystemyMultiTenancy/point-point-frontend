# 🚀 Configuração de Produção (Vercel/Render)

# URL da API backend (Render)
VITE_API_URL=https://point-point-backend.onrender.com

# ✅ STORE ID (Multi-tenant)
# Define a loja padrão quando não há subdomínio específico
# Loja atual: pastel1 (7 produtos cadastrados no banco)
VITE_DEFAULT_STORE_ID=pastel1
#
# Lógica de detecção (PRIORIDADE):
# 1. VITE_DEFAULT_STORE_ID (esta variável) - SEMPRE USADA
# 2. Subdomínio: pastel1.selfmachine.com.br → storeId: "pastel1"
# 3. Fallback: localhost → "pastelaria_01"
#
# Outras lojas (futuras):
# - loja2.selfmachine.com.br → storeId: "loja2"
# - www.selfmachine.com.br → storeId: "pastel1" (via env)
